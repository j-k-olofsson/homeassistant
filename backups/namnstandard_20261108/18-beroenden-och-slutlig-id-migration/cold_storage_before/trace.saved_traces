            "mode": "single",
            "sequence": [
              {
                "action": "rest_command.thread_get_devices",
                "response_variable": "devices_response"
              },
              {
                "variables": {
                  "thread_routers": "{{ devices_response.content\n   | selectattr('role', 'eq', 'router')\n   | map(attribute='extAddress')\n   | list }}"
                }
              },
              {
                "repeat": {
                  "for_each": "{{ thread_routers }}",
                  "sequence": [
                    {
                      "action": "rest_command.thread_get_diagnostics",
                      "data": {
                        "destination": "{{ repeat.item }}"
                      }
                    },
                    {
                      "delay": {
                        "seconds": 1
                      }
                    }
                  ]
                }
              },
              {
                "delay": {
                  "seconds": 35
                }
              },
              {
                "action": "rest_command.thread_get_diagnostics_result",
                "response_variable": "diagnostics_response"
              }
            ]
          },
