                {
                  "type": "tile",
                  "entity": "input_datetime.lights_on",
                  "name": "Lampor tänds",
                  "vertical": true
                },
                {
                  "type": "tile",
                  "entity": "input_datetime.lights_off",
                  "name": "Lampor släcks",
                  "vertical": true
                },
                {
                  "type": "tile",
                  "entity": "input_datetime.growlights_on",
                  "name": "Växtlampor tänds",
                  "vertical": true
                },
                {
                  "type": "tile",
                  "entity": "input_datetime.growlights_late_on",
                  "name": "Växtlampor senare tändning",
                  "vertical": true
                },
                {
                  "type": "tile",
                  "entity": "input_datetime.growlights_off",
                  "name": "Växtlampor släcks",
                  "vertical": true
                },
                {
                  "type": "tile",
                  "entity": "input_datetime.oppna_honsluckan",
                  "name": "Hönsluckan öppnas",
                  "vertical": true
                },
                {
                  "type": "tile",
