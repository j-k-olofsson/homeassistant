                  "name": "Automatiska IR-ljus"
                },
                {
                  "type": "heading",
                  "heading": "Automatiska tillstånd"
                },
                {
                  "features": [
                    {
                      "type": "select-options"
                    }
                  ],
                  "type": "tile",
                  "entity": "input_select.light_scene",
                  "vertical": true,
                  "hide_state": true,
                  "name": "Lampornas scen",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 3
                  }
                },
                {
                  "features": [
                    {
                      "type": "select-options"
                    }
                  ],
                  "type": "tile",
                  "entity": "input_select.sun_phase",
                  "vertical": true,
                  "hide_state": true,
                  "name": "Solens dygnsfas",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 3
                  }
                },
                {
                  "features": [
                    {
                      "type": "select-options"
                    }
                  ],
                  "type": "tile",
                  "entity": "input_select.growlight_scene",
                  "vertical": true,
                  "hide_state": true,
                  "name": "Växtlampors scen",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 3
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading_style": "title",
                  "heading": "IR-styrda ljus"
                },
                {
                  "type": "tile",
                  "entity": "input_select.ir_lights_morning_start",
                  "name": "Morgonstart",
                  "vertical": false,
                  "features": [
                    {
                      "type": "select-options"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "input_number.ir_lights_before_diego_alarm",
                  "name": "Före Diegos alarm",
                  "vertical": true,
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
