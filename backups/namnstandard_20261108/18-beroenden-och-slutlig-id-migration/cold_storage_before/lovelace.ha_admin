{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.ha_admin",
  "data": {
    "config": {
      "views": [
        {
          "title": "Admin",
          "path": "admin",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Tider"
