                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_ljusstyrka_oka",
                  "name": "Öka ljusstyrkan",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_lage_sl",
                  "name": "Slow Light",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_lage_fl",
                  "name": "Fast Light",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_lage_bf",
                  "name": "BF",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_lage_light",
                  "name": "Light",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_timer_2h",
                  "name": "2 tim timer",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_timer_4h",
                  "name": "4 tim timer",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_timer_6h",
                  "name": "6 tim timer",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                },
                {
                  "type": "tile",
                  "entity": "button.varmeljus_timer_8h",
                  "name": "8 tim timer",
                  "vertical": false,
                  "features": [
                    {
                      "type": "button"
                    }
                  ],
                  "features_position": "bottom"
                }
              ],
              "column_span": 2
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Batterier"
                },
                {
                  "type": "custom:auto-entities",
                  "show_empty": false,
                  "unique": true,
                  "card": {
                    "type": "custom:battery-state-card",
                    "filter": null,
                    "secondary_info": "{attributes.battery_type_and_quantity}",
                    "round": 0,
                    "bulk_rename": [
                      {
                        "from": "Battery+"
                      }
                    ],
                    "sort": [
                      "state"
                    ]
                  },
                  "filter": {
                    "include": [
                      {
                        "domain": "sensor",
                        "entity_id": "*_battery_plus",
                        "attributes": {
                          "battery_type_and_quantity": "*"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Närvarosimulering",
                  "heading_style": "title"
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.narvarosimulering_aktiv",
                  "grid_options": {
                    "rows": "auto",
                    "columns": "full"
                  },
                  "name": "Närvarosimulering"
                },
                {
                  "type": "tile",
                  "entity": "input_boolean.narvarosimulering_testlage",
                  "grid_options": {
                    "rows": "auto",
                    "columns": "full"
                  },
                  "name": "Simulering – testläge"
                }
              ]
            }
          ],
          "cards": [],
          "max_columns": 4,
          "icon": "mdi:state-machine",
          "dense_section_placement": true
        },
        {
          "title": "Server",
          "path": "system",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "icon": "mdi:home-percent-outline",
                  "heading": "Belastning",
                  "heading_style": "subtitle"
                },
                {
                  "type": "gauge",
                  "entity": "sensor.processor_use",
                  "name": "CPU",
                  "min": 0,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 75,
                    "red": 90
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  }
                },
                {
                  "type": "gauge",
                  "name": "Minne",
                  "min": 0,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 75,
                    "red": 90
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "entity": "sensor.memory_use_percent"
                },
                {
                  "type": "gauge",
                  "name": "Disk",
                  "min": 0,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 75,
                    "red": 90
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "entity": "sensor.system_monitor_disk_use_percent"
                },
                {
                  "type": "gauge",
                  "name": "Swap",
                  "min": 0,
                  "max": 100,
                  "needle": true,
                  "severity": {
                    "green": 0,
                    "yellow": 75,
                    "red": 90
                  },
                  "grid_options": {
                    "columns": 6,
                    "rows": "auto"
                  },
                  "entity": "sensor.swap_use_percent"
                },
                {
                  "type": "heading",
                  "icon": "mdi:fridge",
                  "heading": "Info",
                  "heading_style": "subtitle"
                },
                {
                  "type": "tile",
                  "entity": "sensor.disk_free",
                  "name": "Fri disk",
                  "icon": "mdi:harddisk",
                  "vertical": false
                },
                {
                  "type": "tile",
                  "entity": "sensor.processor_temperature",
                  "name": "Processortemperatur"
                },
                {
                  "type": "tile",
                  "entity": "sensor.last_boot",
                  "name": "Senaste systemstart"
                }
              ],
              "column_span": 3
            },
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "heading",
                  "heading": "HAGHS · Hälsopoäng",
                  "icon": "mdi:shield-check-outline",
                  "heading_style": "title"
                },
                {
                  "type": "gauge",
                  "entity": "sensor.system_ha_global_health_score",
                  "name": "HAGHS · Total hälsa",
                  "unit": "%",
                  "needle": true,
                  "severity": {
                    "green": 90,
                    "yellow": 75,
                    "red": 0
                  },
                  "min": 0,
                  "max": 100,
                  "grid_options": {
                    "rows": 3,
                    "columns": 6
                  }
                },
                {
                  "type": "markdown",
                  "title": "Poängfördelning",
                  "content": "{% set e = 'sensor.system_ha_global_health_score' %}\n{% if states(e) in ['unknown', 'unavailable'] %}⚠️ HAGHS saknar aktuella data.{% else %}\n| Område | Poäng |\n| :--- | ---: |\n| Hårdvara | **{{ state_attr(e, 'hardware_score') }} / 100** |\n| Applikation | **{{ state_attr(e, 'application_score') }} / 100** |\n\nHårdvara väger 40 % och applikation 60 %.\n{% endif %}",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                },
                {
                  "type": "markdown",
                  "title": "Databas och insamling",
                  "content": "{% set e = 'sensor.system_ha_global_health_score' %}\n{% if states(e) in ['unknown', 'unavailable'] %}⚠️ HAGHS saknar aktuella data.{% else %}\n{% set db = state_attr(e, 'db_size_mb') %}\n{% set keep = state_attr(e, 'recorder_keep_days') %}\n{% set filtered = state_attr(e, 'recorder_filter_active') %}\n| Inställning | Status |\n| :--- | :--- |\n| Databas | {{ (db | float | round(1) ~ ' MB') if db is not none else 'Saknar uppgift' }} |\n| Historik | {{ (keep ~ ' dagar') if keep is not none else 'Saknar uppgift' }} |\n| Entitetsfilter | {{ 'Aktivt' if filtered else 'Ej aktivt' }} |\n| Mätkälla | {{ 'PSI · CPU, RAM och I/O' if state_attr(e, 'psi_available') else 'Klassiska systemsensorer' }} |\n\n{% if keep is none %}⚠️ Kontrollera automatisk rensning av historik.{% endif %}\n{% if not filtered %}💡 Begränsa inspelningen med ett entitetsfilter.{% endif %}\n{% endif %}",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "column_span": 1,
              "cards": [
                {
                  "type": "heading",
                  "heading": "HAGHS · Åtgärder",
                  "icon": "mdi:clipboard-pulse-outline",
                  "heading_style": "title"
                },
                {
                  "type": "markdown",
                  "title": "Rekommendationer",
                  "content": "{% set e = 'sensor.system_ha_global_health_score' %}\n{% if states(e) in ['unknown', 'unavailable'] %}⚠️ HAGHS saknar aktuella data.{% else %}\n{% set rec = state_attr(e, 'recommendations') | default('', true) %}\n{% if rec and '✅' not in rec %}{{ rec }}{% else %}✅ Inga rekommenderade åtgärder.{% endif %}\n{% endif %}",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                },
                {
                  "type": "markdown",
                  "title": "Zombies",
                  "content": "{% set e = 'sensor.system_ha_global_health_score' %}\n{% if states(e) in ['unknown', 'unavailable'] %}⚠️ HAGHS saknar aktuella data.{% else %}\n{% set count = state_attr(e, 'zombie_count') | int(0) %}\n{% set raw = state_attr(e, 'zombie_entities') | default([], true) %}\n{% set items = raw.split(',') | map('trim') | list if raw is string else raw | list %}\n{% if count == 0 %}✅ **Inga zombies upptäckta.**\n{% else %}⚠️ **{{ count }} zombies**\n{% set domains = state_attr(e, 'zombie_count_per_domain') | default({}, true) %}\n{% for domain, n in domains.items() %}{{ domain }}: **{{ n }}**{% if not loop.last %} · {% endif %}{% endfor %}\n\n{% for item in items %}- `{{ item }}`\n{% endfor %}\n{% if count > items | length %}Visar {{ items | length }} av {{ count }}.{% endif %}\n{% endif %}\n\n[Öppna entitetsregistret](/config/entities)\n{% endif %}",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                },
                {
                  "type": "markdown",
                  "title": "Uppdateringar",
                  "content": "{% set e = 'sensor.system_ha_global_health_score' %}\n{% if states(e) in ['unknown', 'unavailable'] %}⚠️ HAGHS saknar aktuella data.{% else %}\n{% set updates = state_attr(e, 'pending_updates') | default([], true) | list %}\n{% if updates %}📦 **{{ updates | length }} väntande uppdateringar**\n\n{% for item in updates %}- {{ item }}\n{% endfor %}\n{% else %}✅ **Inga väntande uppdateringar enligt HAGHS.**{% endif %}\n\n[Öppna uppdateringar](/config/updates)\n{% endif %}",
                  "grid_options": {
                    "columns": 12,
                    "rows": "auto"
                  }
                }
              ]
            }
          ],
          "max_columns": 3,
          "dense_section_placement": false,
          "cards": [],
          "icon": "mdi:server-network"
        },
        {
          "type": "sections",
          "max_columns": 4,
          "title": "Hälsokontroll",
          "path": "health2",
          "icon": "mdi:medical-bag",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "tile",
                  "entity": "sensor.ha_db_size_mb",
                  "features_position": "bottom",
                  "vertical": false,
                  "grid_options": {
                    "columns": "full"
                  },
                  "name": "Databasstorlek"
                },
                {
                  "type": "tile",
                  "entity": "sensor.ha_states_rows_24h",
                  "features_position": "bottom",
                  "vertical": false,
                  "grid_options": {
                    "columns": "full"
                  },
                  "name": "Rader senaste dygnet"
                },
                {
                  "type": "tile",
                  "entity": "sensor.ha_antal_enheter",
                  "features_position": "bottom",
                  "vertical": false,
                  "grid_options": {
                    "columns": "full"
                  },
                  "name": "Antal enheter"
                },
                {
                  "type": "tile",
                  "entity": "sensor.ha_antal_otillgangliga_enheter",
                  "features_position": "bottom",
                  "vertical": false,
                  "grid_options": {
                    "columns": "full"
                  },
                  "name": "Otillgängliga / okända"
                },
                {
                  "type": "tile",
                  "entity": "sensor.ha_antal_otillgangliga_kritiska_enheter",
                  "features_position": "bottom",
                  "vertical": false,
                  "grid_options": {
                    "columns": "full"
                  },
                  "name": "Kritiska otillgängliga"
                }
              ],
              "column_span": 1
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "history-graph",
                  "entities": [
                    {
                      "entity": "sensor.ha_db_size_mb"
                    },
                    {
                      "entity": "sensor.ha_states_rows_24h"
                    }
                  ],
                  "hours_to_show": 168
                }
              ],
              "column_span": 1
            }
          ]
        },
        {
          "title": "Energipris",
          "path": "energipris",
          "icon": "mdi:transmission-tower",
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Avgifter och skatter",
                  "heading_style": "title",
                  "icon": "mdi:cash-multiple"
                },
                {
                  "type": "tile",
                  "entity": "input_number.nordpool_certificate_fee",
                  "name": "Certifikatsavgift",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  },
                  "show_entity_picture": false,
                  "vertical": false,
                  "hide_state": false
                },
                {
                  "type": "tile",
                  "entity": "input_number.nordpool_energy_tax",
                  "name": "Energiskatt",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_number.nordpool_energy_transfer_fee",
                  "name": "Överföringsavgift",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_number.nordpool_spot_fee",
                  "name": "Spotpåslag",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_number.nordpool_trade_fee",
                  "name": "Handelsavgift",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_number.nordpool_vat",
                  "name": "Moms",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  }
                },
                {
                  "type": "tile",
                  "entity": "input_number.nordpool_monthly_fee",
                  "name": "Fasta månadsavgifter"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Priser just nu",
                  "heading_style": "title",
                  "icon": "mdi:cash-multiple"
                },
                {
                  "type": "tile",
                  "entity": "sensor.nordpool",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  },
                  "name": "Elpris"
                },
                {
                  "type": "tile",
                  "entity": "sensor.template_nordpool_base_cost_current_hour",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  },
                  "name": "Inköpspris"
                },
                {
                  "type": "tile",
                  "entity": "sensor.template_nordpool_additional_costs_current_hour",
                  "layout_options": {
                    "grid_columns": 2,
                    "grid_rows": 1
                  },
                  "name": "Påslag"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Progonos (inkl. fasta avgifter) - baserat på kvartar",
                  "heading_style": "title"
                },
                {
                  "type": "tile",
                  "layout_options": {
                    "grid_columns": 4,
                    "grid_rows": 1
                  },
                  "entity": "sensor.kvartbaserad_elkostnadsprognos",
                  "vertical": true,
                  "features_position": "bottom",
                  "name": "Kostnadsprognos"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Ny sektion"
                },
                {
                  "type": "tile",
                  "entity": "sensor.elmatare_elstolpen_current_phase_1",
                  "grid_options": {
                    "rows": "auto",
                    "columns": "full"
                  },
                  "name": "Ström L1"
                },
                {
                  "type": "tile",
                  "entity": "sensor.elmatare_elstolpen_current_phase_2",
                  "grid_options": {
                    "rows": "auto",
                    "columns": "full"
                  },
                  "name": "Ström L2"
                },
