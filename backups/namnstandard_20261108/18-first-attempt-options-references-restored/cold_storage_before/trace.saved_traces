          "config": {
            "id": "1751524387243",
            "alias": "Billaddning \u2013 starta planering",
            "description": "Startar AI-planeringen av bilens laddning och \u00f6verl\u00e5ter schemal\u00e4ggningen till skriptet granny_car_charge_plan.",
            "triggers": [
              {
                "trigger": "homeassistant",
                "event": "start"
              },
              {
                "trigger": "state",
                "entity_id": [
                  "sensor.nordpool"
                ],
                "attribute": "tomorrow_valid",
                "to": 1
              },
              {
                "trigger": "state",
                "entity_id": [
                  "device_tracker.sef_42h_parking_location"
                ],
                "to": "home",
                "for": {
                  "hours": 0,
                  "minutes": 5,
                  "seconds": 0
                }
              },
              {
                "trigger": "template",
                "value_template": "{{ states('sensor.sef_42h_battery_level') | float(999) <\n   states('input_number.car_target_soc') | float(999) }}\n",
                "for": {
                  "hours": 0,
                  "minutes": 5,
                  "seconds": 0
                }
              },
              {
                "trigger": "time_pattern",
                "minutes": "/30",
                "id": "periodic-replan"
              }
            ],
            "conditions": [
              {
                "condition": "template",
                "value_template": "{% set loc = states('device_tracker.sef_42h_parking_location') %} {{ loc in ['home', 'Hemma'] }}\n"
              },
              {
                "condition": "state",
                "entity_id": "input_boolean.car_ai_planning_enabled",
                "state": "on"
              },
              {
                "condition": "state",
                "entity_id": "input_boolean.car_man_override",
                "state": "off"
              },
              {
                "condition": "template",
                "value_template": "{{ states('sensor.sef_42h_battery_level') | float(0) <\n   states('input_number.car_target_soc') | float(100) }}\n"
              },
              {
                "condition": "state",
                "entity_id": "input_boolean.ha_ready",
                "state": "on"
              }
            ],
            "actions": [
              {
                "variables": {
                  "granny_notify_user": "{{ trigger.id | default('') != 'periodic-replan' }}",
                  "granny_window_end_iso": "{% set window_start = now() %} {% set deadline = today_at('05:30:00') %} {% set window_end = deadline if window_start < deadline else (deadline + timedelta(days=1)) %} {{ window_end.isoformat() }}",
                  "granny_tomorrow_valid": "{{ state_attr('sensor.nordpool', 'tomorrow_valid') in [True, 1, 'true'] }}",
                  "granny_price_slots": "{% set sensor = 'sensor.nordpool' %} {% set raw_today = state_attr(sensor, 'raw_today') or [] %} {% set raw_tomorrow = state_attr(sensor, 'raw_tomorrow') or [] %} {% set window_start = now() %} {% set deadline = today_at('05:30:00') %} {% set window_end = deadline if window_start < deadline else (deadline + timedelta(days=1)) %} {% set slots = namespace(count=0) %} {% for item in raw_today + raw_tomorrow %}\n  {% if item is mapping %}\n    {% set start = item.get('start') %}\n    {% set end = item.get('end') %}\n  {% else %}\n    {% set start = item[0] %}\n    {% set end = item[1] %}\n  {% endif %}\n  {% set start_dt = as_datetime(start) if start is not none else none %}\n  {% set end_dt = as_datetime(end) if end is not none else none %}\n  {% if start_dt is none or end_dt is none %}\n    {% continue %}\n  {% endif %}\n  {% if end_dt > window_start and start_dt < window_end %}\n    {% set slots.count = slots.count + 1 %}\n  {% endif %}\n{% endfor %} {{ slots.count }}"
                }
              },
              {
                "choose": [
