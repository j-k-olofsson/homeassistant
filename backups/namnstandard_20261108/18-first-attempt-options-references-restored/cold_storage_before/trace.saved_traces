          "config": {
            "id": "bio_adaptivt_ljus_skydda_natt_och_bio",
            "alias": "Bio \u2013 skydda nattljus och biol\u00e4ge",
            "description": "Stoppar adaptivt ljus i andra l\u00e4gen och skyddar r\u00f6tt nattljus \u00e4ven vid manuell aktivering av profilen.",
            "mode": "restart",
            "triggers": [
              {
                "trigger": "template",
                "value_template": "{{ states('input_select.light_scene') not in ['DAY', 'DAWN', 'DUSK']\n   or not is_state('switch.grupp_hemmabio', 'off') }}",
                "id": "block"
              },
              {
                "trigger": "state",
                "entity_id": "switch.adaptive_lighting_bio",
                "to": "on",
                "id": "profile_on"
              },
              {
                "trigger": "homeassistant",
                "event": "start",
                "id": "startup"
              }
            ],
            "actions": [
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ states('input_select.light_scene') not in ['DAY', 'DAWN', 'DUSK']\n   or not is_state('switch.grupp_hemmabio', 'off') }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "switch.turn_off",
                        "continue_on_error": true,
                        "target": {
                          "entity_id": "switch.adaptive_lighting_bio"
                        }
                      },
                      {
                        "choose": [
                          {
                            "conditions": [
                              {
                                "condition": "state",
                                "entity_id": "switch.grupp_hemmabio",
                                "state": "on"
                              }
                            ],
                            "sequence": [
                              {
                                "action": "light.turn_off",
                                "target": {
                                  "entity_id": [
                                    "light.bordslampa_vanster",
                                    "light.bordslampa_hoger"
                                  ]
                                }
                              }
                            ]
                          },
                          {
                            "conditions": [
                              {
                                "condition": "state",
                                "entity_id": "switch.grupp_hemmabio",
                                "state": "off"
                              },
                              {
                                "condition": "state",
                                "entity_id": "input_select.light_scene",
                                "state": "NIGHT"
                              }
                            ],
                            "sequence": [
                              {
                                "action": "switch.turn_on",
                                "continue_on_error": true,
                                "target": {
                                  "entity_id": "switch.adaptive_lighting_bio_sleep_mode"
                                }
                              },
                              {
                                "variables": {
                                  "_lit": "{{ expand('light.bordslampa_vanster', 'light.bordslampa_hoger')\n   | selectattr('state', 'eq', 'on') | map(attribute='entity_id') | list }}"
                                }
                              },
                              {
                                "if": [
                                  {
                                    "condition": "template",
                                    "value_template": "{{ _lit | count > 0 }}"
                                  }
                                ],
                                "then": [
                                  {
                                    "action": "light.turn_on",
                                    "target": {
                                      "entity_id": "{{ _lit }}"
                                    },
                                    "data": {
                                      "rgb_color": [
                                        255,
                                        0,
                                        0
                                      ],
                                      "brightness_pct": 15,
                                      "transition": 1
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ trigger.id | default('sync') == 'startup' }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "script.bio_adaptivt_ljus_synkronisera"
                      }
                    ]
                  }
                ]
              }
            ]
