          "config": {
            "id": "dashboard_completion_disk",
            "alias": "Kontrollpanel \u2013 disk f\u00e4rdig",
            "description": "Visa ett kvitterbart klarbesked i en timme efter bekr\u00e4ftat avslut. Ny k\u00f6rning tar bort beskedet.",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": "sensor.siemens_016050395510002818_bsh_common_status_operationstate",
                "to": "BSH.Common.EnumType.OperationState.Finished",
                "id": "done"
              },
              {
                "trigger": "state",
                "entity_id": "sensor.siemens_016050395510002818_bsh_common_status_operationstate",
                "to": "BSH.Common.EnumType.OperationState.Run",
                "id": "running"
              }
            ],
            "actions": [
              {
                "choose": [
                  {
                    "conditions": "{{ trigger.id == 'done' and trigger.from_state is not none and trigger.from_state.state in ['BSH.Common.EnumType.OperationState.Run', 'BSH.Common.EnumType.OperationState.Pause', 'BSH.Common.EnumType.OperationState.ActionRequired'] }}",
                    "sequence": [
                      {
                        "action": "timer.start",
                        "target": {
                          "entity_id": "timer.dashboard_disk_klar"
