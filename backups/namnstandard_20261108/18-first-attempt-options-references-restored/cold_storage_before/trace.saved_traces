          "config": {
            "id": "aqara_taklampor_monitor_flash_detector",
            "alias": "Aqara taklampor \u00f6vervakning \u2013 blinkningsdetektor",
            "description": "Detekterar misst\u00e4nkt kort uppg\u00e5ng till h\u00f6g ljusstyrka och klassificerar sannolik orsak.",
            "triggers": [
              {
                "trigger": "state",
                "entity_id": [
                  "light.taklampor_kokson"
                ]
              }
            ],
            "conditions": [
              {
                "condition": "template",
                "value_template": "{% if trigger.from_state is none or trigger.to_state is none %}\n  false\n{% else %}\n  {% set from_on = trigger.from_state.state == 'on' %}\n  {% set to_on = trigger.to_state.state == 'on' %}\n  {% set bf = trigger.from_state.attributes.get('brightness', 0) | int(0) %}\n  {% set bt = trigger.to_state.attributes.get('brightness', 0) | int(0) %}\n  {{ from_on and to_on and bf > 0 and bt >= 230 and (bt - bf) >= 120 }}\n{% endif %}"
              }
            ],
            "actions": [
              {
                "variables": {
                  "bf": "{{ trigger.from_state.attributes.get('brightness', 0) | int(0) }}",
                  "bt": "{{ trigger.to_state.attributes.get('brightness', 0) | int(0) }}",
                  "cmd_ts": "{{ states('input_datetime.aqara_taklampor_senaste_kommando_tid') }}",
                  "btn_ts": "{{ states('input_datetime.aqara_taklampor_senaste_knapp_tid') }}",
                  "cmd_age": "{% if cmd_ts in ['unknown', 'unavailable', '', none] %}\n  999999\n{% else %}\n  {{ (as_timestamp(now()) - as_timestamp(cmd_ts)) | int(999999) }}\n{% endif %}",
                  "btn_age": "{% if btn_ts in ['unknown', 'unavailable', '', none] %}\n  999999\n{% else %}\n  {{ (as_timestamp(now()) - as_timestamp(btn_ts)) | int(999999) }}\n{% endif %}",
                  "cause": "{% if trigger.to_state.context.user_id is not none %}\n  Manuell styrning i app/UI\n{% elif (cmd_age | int(999999)) <= 3 %}\n  Automations/skript/extern tj\u00e4nst skickade ljuskommando\n{% elif (btn_age | int(999999)) <= 3 %}\n  Fysisk knapph\u00e4ndelse fr\u00e5n dimmern\n{% elif trigger.to_state.context.parent_id is not none %}\n  Kedjad automation/skript-trigger (parent context finns)\n{% else %}\n  Spontan rapport fr\u00e5n enhet/driver/last (ingen nylig knapp eller tj\u00e4nst)\n{% endif %}",
                  "msg": "FLASH uppt\u00e4ckt p\u00e5 {{ trigger.entity_id }}: {{ bf }} -> {{ bt }}. Orsak: {{ cause }}. str\u00f6m={{ states('sensor.taklampor_kokson_aktiv_strom') }}A. cmd_age={{ cmd_age }}s btn_age={{ btn_age }}s. ctx={{ trigger.to_state.context.id }} parent={{ trigger.to_state.context.parent_id if trigger.to_state.context.parent_id else 'none' }} user={{ trigger.to_state.context.user_id if trigger.to_state.context.user_id else 'none' }}"
                }
              },
              {
                "action": "counter.increment",
                "target": {
                  "entity_id": "counter.aqara_taklampor_flash_count"
                }
              },
              {
                "action": "input_datetime.set_datetime",
                "target": {
                  "entity_id": "input_datetime.aqara_taklampor_senaste_flash_tid"
                },
                "data": {
                  "datetime": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
                }
              },
              {
                "action": "input_text.set_value",
                "target": {
                  "entity_id": "input_text.aqara_taklampor_senaste_orsak"
                },
                "data": {
                  "value": "{{ cause[:255] }}"
                }
              },
              {
                "action": "input_text.set_value",
                "target": {
                  "entity_id": "input_text.aqara_taklampor_senaste_handelserapport"
                },
                "data": {
                  "value": "{{ msg[:255] }}"
                }
              },
              {
                "action": "persistent_notification.create",
                "data": {
                  "title": "Aqara taklampor: misst\u00e4nkt flash",
                  "message": "{{ msg }}",
                  "notification_id": "aqara_taklampor_flash_latest"
                }
              },
              {
                "action": "logbook.log",
                "data": {
                  "name": "Aqara taklampor monitor",
                  "message": "{{ msg }}",
                  "entity_id": "{{ trigger.entity_id }}"
                }
              },
              {
                "action": "system_log.write",
                "data": {
                  "level": "warning",
                  "message": "{{ msg }}"
                }
              }
            ],
            "mode": "queued",
            "max": 50
          },
          "blueprint_inputs": null,
          "context": {
            "id": "01M6X0EKDCA4ESGG9KHRTX45DK",
            "parent_id": "01M6X0EKDBBSB3SZFPXZNQHH3T",
