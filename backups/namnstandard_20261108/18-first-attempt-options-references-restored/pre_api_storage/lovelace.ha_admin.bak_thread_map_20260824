                  "type": "markdown",
                  "content": "{% set diag = state_attr('sensor.thread_network_diagnostics', 'diagnostics') or [] %}\n  {% set topology = state_attr('sensor.thread_matter_topology', 'nodes') or [] %}\n\n  {# ------------------------------------------------------------\n     Samla HA-enheter från Matter-integrationen\n     ------------------------------------------------------------ #}\n  {% set md = namespace(devices=[]) %}\n\n  {% for entity in integration_entities('matter') %}\n    {% set dev = device_id(entity) %}\n\n    {% if dev and dev not in md.devices %}\n      {% set md.devices = md.devices + [dev] %}\n    {% endif %}\n  {% endfor %}\n\n\n  {# ------------------------------------------------------------\n     Hämta HA-namn från Matter node_id\n     ------------------------------------------------------------ #}\n  {% macro matter_name(node_id) -%}\n\n    {% set found = namespace(name='') %}\n\n    {% for dev in md.devices %}\n\n      {% for ident in device_attr(dev, 'identifiers') or [] %}\n\n        {% if ident[0] == 'matter'\n              and ident[1].startswith('deviceid_') %}\n\n          {% set parts = ident[1].split('-') %}\n\n          {% if parts | count >= 3 %}\n\n            {% set ha_node_id = parts[1] | int(0, 16) %}\n\n            {% if ha_node_id == node_id %}\n              {% set found.name = device_name(dev) %}\n            {% endif %}\n\n          {% endif %}\n\n        {% endif %}\n\n      {% endfor %}\n\n    {% endfor %}\n\n    {{ found.name }}\n\n  {%- endmacro %}\n\n\n  {# ------------------------------------------------------------\n     Hälsobedömning\n     ------------------------------------------------------------ #}\n  {% macro health(d) -%}\n\n    {% set neighbors = d.routerNeighbors | default([], true) %}\n    {% set q = namespace(good=0) %}\n\n    {% for n in neighbors %}\n\n      {% if (n.linkMargin | int(0)) >= 20 %}\n        {% set q.good = q.good + 1 %}\n      {% endif %}\n\n    {% endfor %}\n\n    {% set total = neighbors | count %}\n    {% set ratio = (q.good / total) if total > 0 else 0 %}\n\n    {% set errors =\n         neighbors\n         | map(attribute='messageErrorRate')\n         | list %}\n\n    {% set max_msg =\n         ((errors | max) * 100)\n         if errors | count > 0\n         else 100 %}\n\n    {% if total == 0\n          or q.good == 0\n          or max_msg >= 5 -%}\n\n      red\n\n    {%- elif q.good < 3\n          or ratio < 0.5\n          or max_msg >= 1 -%}\n\n      yellow\n\n    {%- else -%}\n\n      green\n\n    {%- endif %}\n\n  {%- endmacro %}\n\n\n  {# ------------------------------------------------------------\n     Rendera en Thread-nod\n     ------------------------------------------------------------ #}\n  {% macro render_node(d) -%}\n\n    {% set addr = d.extAddress | lower %}\n    {% set neighbors =\n         d.routerNeighbors\n         | default([], true) %}\n\n\n    {# ESPHome-matchning via Thread Extended Address #}\n    {% set esp =\n         states.sensor\n         | selectattr('state', 'eq', addr)\n         | list %}\n\n\n    {# Matter Server topology-matchning #}\n    {% set tn = namespace(node=none) %}\n\n    {% for t in topology %}\n\n      {% if (t.ext_address | default('') | lower) == addr %}\n        {% set tn.node = t %}\n      {% endif %}\n\n    {% endfor %}\n\n\n    {# ----------------------------------------------------------\n       Samla metadata från samtliga OTBR-diagnostikposter\n       ---------------------------------------------------------- #}\n    {% set meta = namespace(\n         stack='',\n         vendor='',\n         model=''\n       ) %}\n\n    {% for c in diag %}\n\n      {% if (c.extAddress | lower) == addr %}\n\n        {% if meta.stack == ''\n              and\n              (c.threadStackVersion\n               | default('')\n               | trim) != '' %}\n\n          {% set meta.stack = c.threadStackVersion %}\n\n        {% endif %}\n\n\n        {% if meta.vendor == ''\n              and\n              (c.vendorName\n               | default('')\n               | trim) != '' %}\n\n          {% set meta.vendor = c.vendorName %}\n\n        {% endif %}\n\n\n        {% if meta.model == ''\n              and\n              (c.vendorModel\n               | default('')\n               | trim) != '' %}\n\n          {% set meta.model = c.vendorModel %}\n\n        {% endif %}\n\n      {% endif %}\n\n    {% endfor %}\n\n\n    {# ----------------------------------------------------------\n       Namnprioritet\n\n       1. ESPHome / HA device name\n       2. Matter node -> HA device registry\n       3. Border Router friendly_name\n       4. Border Router vendor + model\n       5. OTBR vendor + model\n       6. Hexadress\n       ---------------------------------------------------------- #}\n\n    {% if esp | count > 0 %}\n\n      {% set s = esp[0] %}\n\n      {% set name =\n           device_attr(s.entity_id, 'name_by_user')\n           or\n           device_attr(s.entity_id, 'name')\n           or\n           s.name %}\n\n\n    {% elif tn.node is not none\n          and tn.node.kind == 'matter'\n          and tn.node.node_id is defined %}\n\n      {% set mn =\n           matter_name(tn.node.node_id)\n           | trim %}\n\n      {% set name =\n           mn\n           if mn != ''\n           else addr[:8] ~ '…' %}\n\n\n    {% elif tn.node is not none\n          and tn.node.kind == 'border_router'\n          and\n          (tn.node.friendly_name\n           | default('')\n           | trim) != '' %}\n\n      {% set name = tn.node.friendly_name %}\n\n\n    {% elif tn.node is not none\n          and tn.node.kind == 'border_router' %}\n\n      {% set name =\n           (\n             (tn.node.vendor_name | default(''))\n             ~ ' '\n             ~\n             (tn.node.model_name | default(''))\n           )\n           | trim %}\n\n\n    {% elif meta.vendor != '' %}\n\n      {% set name =\n           (meta.vendor ~ ' ' ~ meta.model)\n           | trim %}\n\n\n    {% else %}\n\n      {% set name = addr[:8] ~ '…' %}\n\n    {% endif %}\n\n\n    {# ----------------------------------------------------------\n       Nodtyp\n       ---------------------------------------------------------- #}\n    {% set stack_lower = meta.stack | lower %}\n\n    {% if 'esp32c6' in stack_lower %}\n\n      {% set type = 'ESP32-C6' %}\n\n    {% elif tn.node is not none\n          and tn.node.kind == 'matter' %}\n\n      {% set type = 'Matter' %}\n\n    {% elif tn.node is not none\n          and tn.node.kind == 'border_router' %}\n\n      {% set type = 'Border Router' %}\n\n    {% elif meta.vendor == 'Home Assistant' %}\n\n      {% set type = 'HA OTBR' %}\n\n    {% elif 'efr32' in stack_lower %}\n\n      {% set type = 'EFR32' %}\n\n    {% else %}\n\n      {% set type = 'Thread router' %}\n\n    {% endif %}\n\n\n    {# ----------------------------------------------------------\n       Antal användbara länkar\n       ---------------------------------------------------------- #}\n    {% set q = namespace(good=0) %}\n\n    {% for n in neighbors %}\n\n      {% if (n.linkMargin | int(0)) >= 20 %}\n        {% set q.good = q.good + 1 %}\n      {% endif %}\n\n    {% endfor %}\n\n\n    {# Statusikon #}\n    {% set h = health(d) | trim %}\n\n    {% if h == 'red' %}\n      {% set icon = '🔴' %}\n\n    {% elif h == 'yellow' %}\n      {% set icon = '🟡' %}\n\n    {% else %}\n      {% set icon = '🟢' %}\n    {% endif %}\n\n\n    {# ----------------------------------------------------------\n       Visning\n       ---------------------------------------------------------- #}\n    {% if neighbors | count > 0 %}\n\n      {% set rssis =\n           neighbors\n           | map(attribute='averageRssi')\n           | list %}\n\n      {% set margins =\n           neighbors\n           | map(attribute='linkMargin')\n           | list %}\n\n      {% set errors =\n           neighbors\n           | map(attribute='messageErrorRate')\n           | list %}\n\n      {% set best_rssi = rssis | max %}\n      {% set min_margin = margins | min %}\n\n      {% set max_error =\n           ((errors | max) * 100)\n           | round(1) %}\n\n  {{ icon }} **{{ name }}** · {{ type }}  \n  {{ q.good }}/{{ neighbors | count }} bra länkar · RSSI **{{ best_rssi }} dBm** · min margin **{{ min_margin }} dB** · msgfel **{{ max_error }} %**\n\n    {% else %}\n\n  🔴 **{{ name }}** · {{ type }}  \n  Ingen granninformation\n\n    {% endif %}\n\n  {%- endmacro %}\n\n\n  {# ------------------------------------------------------------\n     Sortering:\n     🔴 -> 🟡 -> 🟢\n\n     Samtidigt väljs den diagnostikpost för varje nod\n     som innehåller flest routerNeighbors.\n     ------------------------------------------------------------ #}\n\n  {% set ns = namespace(seen=[]) %}\n\n  {% for wanted in ['red', 'yellow', 'green'] %}\n\n    {% for d in diag %}\n\n      {% set candidates =\n           diag\n           | selectattr(\n               'extAddress',\n               'eq',\n               d.extAddress\n             )\n           | list %}\n\n      {% set best = namespace(count=-1) %}\n\n      {% for c in candidates %}\n\n        {% set cnt =\n             (c.routerNeighbors\n              | default([], true))\n             | count %}\n\n        {% if cnt > best.count %}\n          {% set best.count = cnt %}\n        {% endif %}\n\n      {% endfor %}\n\n\n      {% set current_count =\n           (d.routerNeighbors\n            | default([], true))\n           | count %}\n\n\n      {% if d.extAddress not in ns.seen\n            and\n            current_count == best.count\n            and\n            (health(d) | trim) == wanted %}\n\n        {% set ns.seen =\n             ns.seen + [d.extAddress] %}\n\n        {{ render_node(d) }}\n\n      {% endif %}\n\n    {% endfor %}\n\n  {% endfor %}\n\n    {# ------------------------------------------------------------\n     Sleepy End Devices\n     ------------------------------------------------------------ #}\n\n  {% set child_links =\n       state_attr(\n         'sensor.thread_matter_topology',\n         'child_links'\n       ) or [] %}\n\n  {% for t in topology %}\n\n    {% if (t.role | default('')) == 'sleepy_end_device' %}\n\n      {# HA-namn på den sovande Matter-enheten #}\n      {% set mn =\n           (matter_name(t.node_id) | trim)\n           if t.node_id is defined\n           else '' %}\n\n      {% set name =\n           mn\n           if mn != ''\n           else\n           (t.ext_address | default('okänd'))[:8] ~ '…' %}\n\n\n      {# Hitta länken för denna sleepy node #}\n      {% set ln = namespace(link=none) %}\n\n      {% for l in child_links %}\n\n        {% if (l.source | string) == (t.id | string)\n              or\n              (l.target | string) == (t.id | string) %}\n\n          {% set ln.link = l %}\n\n        {% endif %}\n\n      {% endfor %}\n\n\n      {# Identifiera andra änden = föräldraroutern #}\n      {% set parent = namespace(\n           id='',\n           node=none,\n           name=''\n         ) %}\n\n      {% if ln.link is not none %}\n\n        {% if (ln.link.source | string) == (t.id | string) %}\n          {% set parent.id = ln.link.target %}\n        {% else %}\n          {% set parent.id = ln.link.source %}\n        {% endif %}\n\n\n        {# Hitta motsvarande topology node #}\n        {% for p in topology %}\n\n          {% if (p.id | string) == (parent.id | string) %}\n            {% set parent.node = p %}\n          {% endif %}\n\n        {% endfor %}\n\n\n        {% if parent.node is not none %}\n\n          {% set paddr =\n               parent.node.ext_address\n               | default('')\n               | lower %}\n\n\n          {# ESPHome-namn har högst prioritet #}\n          {% set esp =\n               states.sensor\n               | selectattr('state', 'eq', paddr)\n               | list %}\n\n          {% if esp | count > 0 %}\n\n            {% set s = esp[0] %}\n\n            {% set parent.name =\n                 device_attr(s.entity_id, 'name_by_user')\n                 or\n                 device_attr(s.entity_id, 'name')\n                 or\n                 s.name %}\n\n\n          {# Matter-router #}\n          {% elif parent.node.kind == 'matter'\n                and parent.node.node_id is defined %}\n\n            {% set pm =\n                 matter_name(parent.node.node_id)\n                 | trim %}\n\n            {% set parent.name =\n                 pm\n                 if pm != ''\n                 else paddr[:8] ~ '…' %}\n\n\n          {# Border Router #}\n          {% elif parent.node.kind == 'border_router'\n                and\n                (parent.node.friendly_name\n                 | default('')\n                 | trim) != '' %}\n\n            {% set parent.name =\n                 parent.node.friendly_name %}\n\n\n          {% elif parent.node.kind == 'border_router' %}\n\n            {% set parent.name =\n                 (\n                   (parent.node.vendor_name | default(''))\n                   ~ ' '\n                   ~\n                   (parent.node.model_name | default(''))\n                 )\n                 | trim %}\n\n\n          {% else %}\n\n            {% set parent.name =\n                 paddr[:8] ~ '…' %}\n\n          {% endif %}\n\n        {% endif %}\n\n      {% endif %}\n\n\n      {# --------------------------------------------------------\n         Status och presentation\n         -------------------------------------------------------- #}\n\n      {% if not (t.available | default(false)) %}\n\n  🔴 **{{ name }}** · Matter · Sleepy End Device  \n  Ej tillgänglig\n\n      {% elif ln.link is none %}\n\n  🟡 **{{ name }}** · Matter · Sleepy End Device  \n  Tillgänglig · ingen aktuell föräldralänk\n\n      {% else %}\n\n        {% set lqi =\n             ln.link.lqi\n             | default(0, true)\n             | int %}\n\n        {% set rssi =\n             ln.link.rssi\n             | default(none) %}\n\n\n        {% if lqi >= 3 %}\n          {% set icon = '🟢' %}\n        {% elif lqi == 2 %}\n          {% set icon = '🟡' %}\n        {% else %}\n          {% set icon = '🔴' %}\n        {% endif %}\n\n  {{ icon }} **{{ name }}** · Matter · Sleepy End Device  \n  Förälder: **{{ parent.name }}** · RSSI **{{ rssi }} dBm** · LQI **{{ lqi }}**\n\n      {% endif %}\n\n    {% endif %}\n\n  {% endfor %}\n  ---\n  Senast uppdaterad: {{\n    as_timestamp(\n      state_attr(\n        'sensor.thread_network_diagnostics',\n        'updated'\n      )\n    )\n    | timestamp_custom(\n        '%Y-%m-%d %H:%M:%S'\n      )\n  }}",
