          "config": {
            "id": "1674139073169",
            "alias": "Hissmusik",
            "description": "Spelar lokala MA-listor med blandad l\u00e5tordning p\u00e5 Dassens h\u00f6gtalare. Hissmusik 05:30 vardagar, 07:00 helger och 20:00 alla dagar. Motown & Soul (60s, 70s & 80s) 08:00 alla dagar. Knappen och manuell k\u00f6rning v\u00e4ljer Motown 08:00\u201319:59, annars Hissmusik. Stoppar 22:00. Tiderna f\u00f6ljer Home Assistants tidszon Europe/Stockholm.",
            "triggers": [
              {
                "entity_id": [
                  "input_button.spela_hissmusik"
                ],
                "trigger": "state",
                "id": "google-voice"
              },
