          "config": {
            "id": "aqara_taklampor_monitor_service_calls",
            "alias": "Aqara taklampor monitor - service calls",
            "description": "Loggar senaste service-kommando som riktar sig mot taklamporna.",
            "triggers": [
              {
                "trigger": "event",
                "event_type": "call_service"
              }
            ],
            "conditions": [
              {
                "condition": "template",
                "value_template": "{{ trigger.event.data.domain not in ['logbook', 'system_log', 'input_text', 'input_datetime'] }}"
              },
              {
                "condition": "template",
                "value_template": "{% set sd = trigger.event.data.service_data if trigger.event and trigger.event.data else {} %} {% set eid = sd.entity_id if sd is mapping and 'entity_id' in sd else none %} {% if eid is string %}\n  {{ eid in ['light.taklampor_kokson', 'light.grupp_taklampor_kok'] }}\n{% elif eid is iterable and eid is not string %}\n  {{ 'light.taklampor_kokson' in eid or 'light.grupp_taklampor_kok' in eid }}\n{% else %}\n  false\n{% endif %}"
              }
            ],
            "actions": [
              {
                "action": "input_datetime.set_datetime",
                "target": {
                  "entity_id": "input_datetime.aqara_taklampor_senaste_kommando_tid"
                },
                "data": {
                  "datetime": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
                }
              },
