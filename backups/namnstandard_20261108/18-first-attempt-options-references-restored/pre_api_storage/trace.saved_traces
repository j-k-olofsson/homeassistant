                "variables": {
                  "schedule_lines": "{% if plan_schedule_effective | length == 0 %} - Inga laddningsslotar beh\u00f6vs just nu. {% else %} {%- for slot in plan_schedule_effective %} {% set slot_obj = slot %} {% if slot_obj is string %}\n  {% set slot_obj = slot_obj | from_json(default={}) %}\n{% endif %} {% set slot_start = slot_obj.get('start') %} {% set slot_end = slot_obj.get('end') %} {% set slot_energy = slot_obj.get('energy_kwh', slot_obj.get('energy')) %} - {{ as_local(as_datetime(slot_start)).strftime('%d %b %H:%M') if slot_start else 'ok\u00e4nd' }}\u2013{{ as_local(as_datetime(slot_end)).strftime('%H:%M') if slot_end else 'ok\u00e4nd' }} (\u2248{{ slot_energy | float(0) | round(2) }} kWh) {%- endfor %} {% endif %}",
                  "granny_task": "SYSTEM Du \u00e4r \"Granny\", familjens hj\u00e4rtliga r\u00e5dgivare. Tala svenska, max 60 ord, varm men rak.\nDATA Status: {{ plan_status if plan_status | length > 0 else 'ok' }} Sammanfattning: {{ plan_summary_clean if plan_summary_clean | length > 0 else 'Ingen sammanfattning tillg\u00e4nglig.' }} Total energi: {{ total_energy_kwh | float(0) | round(2) }} kWh Total kostnad: {{ total_cost_value | float(0) | round(2) }} {{ plan_currency }} Tidsluckor: {{ schedule_lines }}\nUPPDRAG F\u00f6rklara planen kort, peppa familjen och p\u00e5minn om tidsluckorna.",
                  "broadcast_fallback": "{% if plan_notes_clean | length > 0 %}\n  {{ plan_notes_clean }}\n{% elif plan_summary_clean | length > 0 %}\n  {{ plan_summary_clean }}\n{% else %}\n  Laddningsplanen \u00e4r uppdaterad men ingen text genererades.\n{% endif %}",
                  "status_notification_body": "{% set ns = namespace(parts=[]) %} {% if plan_schedule_effective | length == 0 %}\n  {% set ns.parts = ns.parts + ['Ingen laddning planerad just nu.'] %}\n{% else %}\n  {% set ns.parts = ns.parts + ['Plan klar: ' ~ (plan_schedule_effective | length) ~ ' slotar, energi \u2248 ' ~ (total_energy_kwh | float(0) | round(2)) ~ ' kWh, kostnad \u2248 ' ~ (total_cost_value | float(0) | round(2)) ~ ' ' ~ plan_currency ~ '.'] %}\n{% endif %} {% set ns.parts = ns.parts + ['Total energi \u2248 ' ~ (total_energy_kwh | float(0) | round(2)) ~ ' kWh, total kostnad \u2248 ' ~ (total_cost_value | float(0) | round(2)) ~ ' ' ~ plan_currency ~ '.'] %} {% for slot in plan_schedule_effective %}\n  {% set slot_obj = slot %}\n  {% if slot_obj is string %}\n    {% set slot_obj = slot_obj | from_json(default={}) %}\n  {% endif %}\n  {% set slot_start = slot_obj.get('start') %}\n  {% set slot_end = slot_obj.get('end') %}\n  {% set slot_energy = slot_obj.get('energy_kwh', slot_obj.get('energy')) %}\n  {% set ns.parts = ns.parts + ['- ' ~ (as_local(as_datetime(slot_start)).strftime('%d %b %H:%M') if slot_start else 'ok\u00e4nd') ~ '\u2013' ~ (as_local(as_datetime(slot_end)).strftime('%H:%M') if slot_end else 'ok\u00e4nd') ~ ' (\u2248' ~ (slot_energy | float(0) | round(2)) ~ ' kWh)'] %}\n{% endfor %} {{ ns.parts | join('\\n') }}"
                }
