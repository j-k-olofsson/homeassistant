          "config": {
            "alias": "Hissmusik - Starta lokal musik",
            "description": "Spelar angiven lokal MA-spellista (standard Hissmusik) p\u00e5 Dassens h\u00f6gtalare med 15 % volym, shuffle och repeat all. H\u00f6gst tre startf\u00f6rs\u00f6k; avbryter direkt n\u00e4r gruppen spelar och meddelar vid fel.",
            "mode": "restart",
            "fields": {
              "spellista": {
                "name": "Spellista",
                "description": "Lokal MA-lista att spela. Hissmusik anv\u00e4nds om inget val anges.",
                "default": "hissmusik",
                "selector": {
                  "select": {
                    "options": [
                      {
                        "label": "Hissmusik",
                        "value": "hissmusik"
                      },
                      {
                        "label": "Motown & Soul (60s, 70s & 80s)",
                        "value": "motown"
                      }
                    ]
                  }
                }
              }
            },
            "trace": {
              "stored_traces": 10
            },
            "sequence": [
              {
                "variables": {
                  "hissmusik_player": "media_player.dassens_hogtalare_ma",
                  "hissmusik_playlists": {
                    "hissmusik": {
                      "name": "Hissmusik",
                      "uri": "library://playlist/58"
                    },
                    "motown": {
                      "name": "Motown & Soul (60s, 70s & 80s)",
                      "uri": "library://playlist/59"
                    }
                  }
                }
              },
              {
                "variables": {
                  "hissmusik_playlist": "{{ hissmusik_playlists[spellista | default('hissmusik')] }}"
                }
              },
              {
                "repeat": {
                  "sequence": [
                    {
                      "alias": "V\u00e4nta p\u00e5 att MA-gruppen \u00e4r tillg\u00e4nglig",
                      "wait_template": "{{ states(hissmusik_player) not in ['unknown', 'unavailable'] }}",
                      "timeout": "00:00:20",
                      "continue_on_timeout": true
                    },
                    {
                      "if": [
                        {
                          "condition": "template",
                          "value_template": "{{ wait.completed }}"
                        }
                      ],
                      "then": [
                        {
                          "alias": "Stoppa f\u00f6reg\u00e5ende k\u00f6 f\u00f6re ett nytt startf\u00f6rs\u00f6k",
                          "action": "media_player.media_stop",
                          "continue_on_error": true,
                          "target": {
                            "entity_id": "{{ hissmusik_player }}"
                          }
                        },
                        {
                          "wait_template": "{{ not is_state(hissmusik_player, 'playing') }}",
                          "timeout": "00:00:10",
                          "continue_on_timeout": true
                        },
                        {
                          "if": [
                            {
                              "condition": "template",
                              "value_template": "{{ wait.completed }}"
                            }
                          ],
                          "then": [
                            {
                              "action": "media_player.volume_set",
                              "continue_on_error": true,
                              "target": {
                                "entity_id": "{{ hissmusik_player }}"
                              },
                              "data": {
                                "volume_level": 0.15
                              }
                            },
                            {
                              "action": "media_player.volume_mute",
                              "continue_on_error": true,
                              "target": {
                                "entity_id": "{{ hissmusik_player }}"
                              },
                              "data": {
                                "is_volume_muted": false
                              }
                            },
                            {
                              "action": "media_player.shuffle_set",
                              "continue_on_error": true,
                              "target": {
                                "entity_id": "{{ hissmusik_player }}"
                              },
                              "data": {
                                "shuffle": true
                              }
                            },
                            {
                              "action": "media_player.repeat_set",
                              "continue_on_error": true,
                              "target": {
                                "entity_id": "{{ hissmusik_player }}"
                              },
                              "data": {
                                "repeat": "all"
                              }
                            },
                            {
                              "alias": "Starta den valda lokala spellistan p\u00e5 gruppen",
                              "action": "music_assistant.play_media",
                              "continue_on_error": true,
                              "target": {
                                "entity_id": "{{ hissmusik_player }}"
                              },
                              "data": {
                                "media_id": "{{ hissmusik_playlist.uri }}",
                                "media_type": "playlist",
                                "enqueue": "replace",
                                "radio_mode": false
                              }
                            },
                            {
                              "wait_template": "{{ is_state(hissmusik_player, 'playing') }}",
                              "timeout": "00:00:30",
                              "continue_on_timeout": true
                            },
                            {
                              "if": [
                                {
                                  "condition": "template",
                                  "value_template": "{{ wait.completed }}"
                                }
                              ],
                              "then": [
                                {
                                  "action": "persistent_notification.dismiss",
                                  "data": {
                                    "notification_id": "hissmusik_startfel"
                                  }
                                },
                                {
                                  "action": "logbook.log",
                                  "data": {
                                    "name": "Hissmusik",
                                    "message": "Spelar {{ hissmusik_playlist.name }} fr\u00e5n lokala filer p\u00e5 Dassens h\u00f6gtalare (f\u00f6rs\u00f6k {{ repeat.index }}).",
                                    "entity_id": "{{ hissmusik_player }}"
                                  }
                                },
                                {
                                  "stop": "Dassens h\u00f6gtalare spelar den lokala spellistan."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "until": [
                    {
                      "condition": "template",
                      "value_template": "{{ repeat.index >= 3 }}"
                    }
                  ]
                }
              },
              {
                "action": "persistent_notification.create",
                "data": {
                  "notification_id": "hissmusik_startfel",
                  "title": "Hissmusik kunde inte starta",
                  "message": "Kunde inte starta {{ hissmusik_playlist.name }} p\u00e5 Dassens h\u00f6gtalare efter tre f\u00f6rs\u00f6k. Gruppens status \u00e4r {{ states(hissmusik_player) }}. Kontrollera Music Assistant, h\u00f6gtalargruppen och de lokala musikfilerna."
                }
              },
              {
                "stop": "Hissmusik kunde inte starta efter tre f\u00f6rs\u00f6k.",
                "error": true
              }
            ]
          },
