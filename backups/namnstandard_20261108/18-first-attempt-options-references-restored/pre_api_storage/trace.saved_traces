          "config": {
            "alias": "Granny Broadcast (kanalneutral)",
            "description": "Grannifiera en uppgift och (valfritt) skicka till valda kanaler. Returnerar alltid final_message.\n",
            "mode": "parallel",
            "max": 50,
            "fields": {
              "task": {
                "name": "task",
                "description": "Kort instruktion till Granny (obligatorisk)",
                "required": true,
                "selector": {
                  "text": {}
                }
              },
              "severity": {
                "name": "severity",
                "selector": {
                  "select": {
                    "options": [
                      "info",
                      "warn",
                      "crit"
                    ]
                  }
                },
                "default": "info"
              },
              "humor_level": {
                "name": "humor_level",
                "selector": {
                  "number": {
                    "min": 0,
                    "max": 3,
                    "step": 1
                  }
                },
                "default": 2
              },
              "recipient": {
                "name": "recipient",
                "description": "Namn att tilltala (t.ex. Diego)",
                "selector": {
                  "text": {}
                }
              },
              "channels": {
                "name": "Kanaler",
                "description": "V\u00e4lj en eller flera kanaler (l\u00e4mna tom f\u00f6r att inte skicka n\u00e5got)",
                "selector": {
                  "select": {
                    "multiple": true,
                    "options": [
                      {
                        "label": "TTS (h\u00f6gtalare/grupp)",
                        "value": "tts"
                      },
                      {
                        "label": "Mobil (notify.mobile_app_pixel_9_pro_xl)",
                        "value": "mobile"
                      },
                      {
                        "label": "TV",
                        "value": "tv"
                      },
                      {
                        "label": "HA-notis (persistent_notification)",
                        "value": "ha"
                      },
                      {
                        "label": "Slack (notify.flocken)",
                        "value": "slack"
                      }
                    ]
                  }
                }
              },
              "tts_media_player": {
                "name": "tts_media_player",
                "description": "Music Assistant-spelare f\u00f6r TTS (standard: Grannys synkroniserade Chromecast-grupp)\n",
                "selector": {
                  "entity": {
                    "domain": "media_player",
                    "integration": "music_assistant"
                  }
                }
              },
              "prompt_override": {
                "name": "Egen fullst\u00e4ndig AI-prompt",
                "description": "Ers\u00e4tter hela Granny-prompten f\u00f6r detta anrop. Tomt anv\u00e4nder standardprompten.",
                "selector": {
                  "text": {
                    "multiline": true
                  }
                }
              },
              "tts_ignore_quiet_hours": {
                "name": "Till\u00e5t tal under tyst period",
                "description": "Anv\u00e4nds f\u00f6r uttryckligen beg\u00e4rda utrop, exempelvis Godnatt.",
                "default": false,
                "selector": {
                  "boolean": {}
                }
              },
              "message": {
                "name": "F\u00e4rdigt meddelande",
                "description": "L\u00e4s upp och visa exakt denna text utan AI-omskrivning.",
                "selector": {
                  "text": {
                    "multiline": true
                  }
                }
              },
              "fallback_message": {
                "name": "fallback_message",
                "description": "Eget fallbackmeddelande om AI inte svarar. L\u00e4mna tomt f\u00f6r neutral standardfras.\n",
                "selector": {
                  "text": {}
                }
              },
              "slack_channel": {
                "name": "Slack-kanal",
                "description": "Valfri Slack-kanal eller anv\u00e4ndare, t.ex. #allmant eller @diego. L\u00e4mna tomt f\u00f6r integrationens standardm\u00e5l.\n",
                "selector": {
                  "text": {}
                }
              }
            },
            "sequence": [
              {
                "variables": {
                  "_ai_entity": "ai_task.ollama_ai_task",
                  "_severity": "{{ severity | default('info') }}",
                  "_humor": "{{ humor_level | default(2) | int(2) }}",
                  "_recipient": "{{ (recipient | default('', true)) | trim }}",
                  "_tts_player": "{{ tts_media_player\n   if tts_media_player is defined and tts_media_player|length > 0\n   else 'media_player.grannys_hogtalare' }}\n",
                  "_tts_engine": "{{ 'tts.piper' if states.tts.piper is defined and\n   states('tts.piper') != 'unavailable' else 'tts.home_assistant_cloud' }}",
                  "_message_input": "{{ message | default(\"\", true) | trim }}",
                  "_fallback_input": "{{ (fallback_message | default('', true)) | trim }}",
                  "_fallback_default": "Jag har gl\u00f6mt bort vad jag skulle s\u00e4ga, och \u00e4ven vad jag heter\u2026",
                  "_fallback_final": "{{ _fallback_input if _fallback_input|length > 0 else _fallback_default }}\n",
                  "_channels": "{{ channels if channels is defined else [] }}\n",
                  "_tts_quiet_start_ts": "{{ as_timestamp(today_at('21:30:00')) | float(0) }}",
                  "_tts_quiet_end_ts": "{{ as_timestamp(today_at('06:00:00')) | float(0) }}",
                  "_tts_in_quiet_hours": "{{ (as_timestamp(now()) | float(0)) >= (_tts_quiet_start_ts | float(0)) or (as_timestamp(now()) | float(0)) < (_tts_quiet_end_ts | float(0)) }}",
                  "_slack_channel": "{{ (slack_channel | default('', true)) | trim }}",
                  "_base_task": "{{ task }}",
                  "_prompt": "Du \u00e4r \"Granny\": varm, saklig, kvick och surmulen. Svara alltid p\u00e5 svenska. Humor-niv\u00e5: {{ _humor }} (0=ingen, 3=lekfull men kort). Allvar: {{ _severity }}. {{ 'Tilltala ' ~ _recipient ~ '.' if _recipient|length > 0 else '' }} Uppdrag: {{ _base_task }} Krav: Max 40 ord. Kort, tydligt, v\u00e4nligt. Ingen emoji. Alltid nya unika meddelanden, aldrig upprepningar."
                }
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ _message_input | length == 0 and states(_ai_entity) not in ['unknown','unavailable',''] }}\n"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "ai_task.generate_data",
                        "continue_on_error": true,
                        "data": {
                          "entity_id": "{{ _ai_entity }}",
                          "instructions": "{{ (prompt_override | default('', true) | trim) or _prompt }}",
                          "task_name": "granny_broadcast"
                        },
                        "response_variable": "ai_out"
                      },
                      {
                        "variables": {
                          "ai_text": "{{ (ai_out.data if ai_out is defined and 'data' in ai_out\n    else '') | string | trim }}\n"
                        }
                      }
                    ]
                  }
                ],
                "default": [
                  {
                    "variables": {
                      "ai_text": ""
                    }
                  }
                ]
              },
              {
                "variables": {
                  "final_message": "{{ _message_input if _message_input | length > 0 else (ai_text if (ai_text | length) > 0 else _fallback_final) }}\n"
                }
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ 'tts' in _channels and\n   (not _tts_in_quiet_hours or\n    (tts_ignore_quiet_hours | default(false) | bool(false))) }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "script.granny_announce",
                        "continue_on_error": true,
                        "data": {
                          "media_player": "{{ _tts_player }}",
                          "tts_engine": "{{ _tts_engine }}",
                          "message": "{{ final_message }}"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ 'mobile' in _channels }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "notify.mobile_app_pixel_9_pro_xl",
                        "data": {
                          "title": "Granny ({{ _severity }})",
                          "message": "{{ final_message }}"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ 'tv' in _channels }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "notify.send_message",
                        "target": {
                          "entity_id": "notify.android_tv_fire_tv"
                        },
                        "data": {
                          "title": "Granny",
                          "message": "{{ final_message }}"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ 'ha' in _channels }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "persistent_notification.create",
                        "data": {
                          "title": "Granny ({{ _severity }})",
                          "message": "{{ final_message }}"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ 'slack' in _channels }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "notify.flocken",
                        "data": {
                          "title": "Granny ({{ _severity }})",
                          "message": "{{ final_message }}",
                          "target": "{{ [_slack_channel] if _slack_channel|length > 0 else [] }}\n"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "variables": {
                  "broadcast_response": {
                    "final_message": "{{ final_message }}"
                  }
                }
              },
              {
                "stop": "{{ final_message }}",
                "response_variable": "broadcast_response"
              }
            ]
          },
