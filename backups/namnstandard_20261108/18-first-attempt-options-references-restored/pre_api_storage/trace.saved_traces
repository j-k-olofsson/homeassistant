            "alias": "Granny Bil-laddningsplan",
            "description": "Planerar bilens laddning via en lokal prisoptimering och uppdaterar kalendern.",
            "mode": "restart",
            "fields": {
              "notify_user": {
                "name": "Skicka statusnotis",
                "description": "Skicka informativa Granny-notiser n\u00e4r planen \u00e4r klar.",
                "selector": {
                  "boolean": {}
                },
                "default": true
              }
            },
            "sequence": [
              {
                "variables": {
                  "log_prefix": "[Granny Laddning]",
                  "status_notification_id": "granny_plan_status",
                  "notify_user_bool": "{{ (notify_user | default(true)) not in [false, False, 'false', 'False', 0, '0', 'off', 'no'] }}",
                  "slot_minutes": 15,
                  "now_dt": "{{ now() }}",
                  "now_iso": "{{ now().isoformat() }}",
                  "deadline_iso": "{% set base = today_at('05:30:00') %} {{ (base if now() < base else (base + timedelta(days=1))).isoformat() }}",
                  "deadline_local_iso": "{{ as_local(as_datetime(deadline_iso)).isoformat() }}",
                  "cleanup_end_iso": "{{ (today_at('23:59:59') + timedelta(days=1)).isoformat() }}",
                  "car_soc": "{{ states(\"sensor.sef_42h_battery_level\") | float(0) }}",
                  "car_target": "{{ states(\"input_number.car_target_soc\") | float(100) }}",
                  "car_capacity_kwh": "{{ states(\"input_number.car_bat_capacity\") | float(0) }}",
                  "car_charger_kw": "{{ states(\"input_number.car_charger_capacity\") | float(0) }}",
                  "car_efficiency": "{{ states(\"input_number.car_charger_efficiency\") | float(1) }}",
                  "energy_needed_kwh": "{% set diff = (car_target | float(0)) - (car_soc | float(0)) %} {% if diff <= 0 or (car_capacity_kwh | float(0)) <= 0 %}\n  {{ 0.0 }}\n{% else %}\n  {{ ((diff / 100) * (car_capacity_kwh | float(0))) | float(0) }}\n{% endif %}",
                  "slot_energy_kwh": "{% set kw = car_charger_kw | float(0) %} {% set eff = car_efficiency | float(1) %} {% set minutes = slot_minutes | float(0) %} {% set duration = minutes / 60 %} {% if kw <= 0 or duration <= 0 or eff <= 0 %}\n  {{ 0.0 }}\n{% else %}\n  {{ (kw * duration * eff) | float(0) }}\n{% endif %}",
                  "min_slots_required": "{% set needed = energy_needed_kwh | float(0) %} {% set per_slot = slot_energy_kwh | float(0) %} {% if needed <= 0 or per_slot <= 0 %}\n  0\n{% else %}\n  {{ (needed / per_slot) | round(0, 'ceil') | int }}\n{% endif %}",
                  "price_payload": "{% set sensor = 'sensor.nordpool' %} {% set raw_today = state_attr(sensor, 'raw_today') or [] %} {% set raw_tomorrow = state_attr(sensor, 'raw_tomorrow') or [] %} {% set window_start = as_datetime(now_iso) %} {% set window_end = as_datetime(deadline_iso) %} {% set today_ns = namespace(items=[]) %} {% for item in raw_today %}\n  {% if item is mapping %}\n    {% set start = item.get('start') %}\n    {% set end = item.get('end') %}\n    {% set value = item.get('value') %}\n  {% else %}\n    {% set start = item[0] %}\n    {% set end = item[1] %}\n    {% set value = item[2] %}\n  {% endif %}\n  {% set start_dt = as_datetime(start) if start is not none else none %}\n  {% set end_dt = as_datetime(end) if end is not none else none %}\n  {% if start_dt is none or end_dt is none %}\n    {% continue %}\n  {% endif %}\n  {% if end_dt <= window_start or start_dt >= window_end %}\n    {% continue %}\n  {% endif %}\n  {% set today_ns.items = today_ns.items + [{\n    \"start\": start_dt.isoformat(),\n    \"end\": end_dt.isoformat(),\n    \"value\": value | float(0),\n    \"source\": \"nordpool.today\"\n  }] %}\n{% endfor %} {% set tomorrow_ns = namespace(items=[]) %} {% for item in raw_tomorrow %}\n  {% if item is mapping %}\n    {% set start = item.get('start') %}\n    {% set end = item.get('end') %}\n    {% set value = item.get('value') %}\n  {% else %}\n    {% set start = item[0] %}\n    {% set end = item[1] %}\n    {% set value = item[2] %}\n  {% endif %}\n  {% set start_dt = as_datetime(start) if start is not none else none %}\n  {% set end_dt = as_datetime(end) if end is not none else none %}\n  {% if start_dt is none or end_dt is none %}\n    {% continue %}\n  {% endif %}\n  {% if end_dt <= window_start or start_dt >= window_end %}\n    {% continue %}\n  {% endif %}\n  {% set tomorrow_ns.items = tomorrow_ns.items + [{\n    \"start\": start_dt.isoformat(),\n    \"end\": end_dt.isoformat(),\n    \"value\": value | float(0),\n    \"source\": \"nordpool.tomorrow\"\n  }] %}\n{% endfor %} {{\n  {\n    \"currency\": state_attr(sensor, \"currency\"),\n    \"vat\": state_attr(sensor, \"vat\"),\n    \"today\": today_ns.items,\n    \"tomorrow\": tomorrow_ns.items\n  } | tojson\n}}",
                  "price_currency_attr": "{{ state_attr('sensor.nordpool', 'currency') | default('SEK') }}",
                  "price_currency": "{% set attr = price_currency_attr | string | upper %} {% if 'SEK' in attr %}\n  SEK\n{% else %}\n  SEK\n{% endif %}"
                }
              },
              {
                "choose": [
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ car_capacity_kwh | float(0) <= 0 }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "logbook.log",
                        "data": {
                          "name": "{{ log_prefix }}",
                          "message": "Planeringen stoppad: s\u00e4tt ett v\u00e4rde p\u00e5 input_number.car_bat_capacity."
                        }
                      },
                      {
                        "action": "persistent_notification.create",
                        "data": {
                          "title": "Laddningsplan saknar batterikapacitet",
                          "message": "Ange bilens batterikapacitet i input_number.car_bat_capacity f\u00f6r att kunna planera laddningen.",
                          "notification_id": "granny_car_charge_plan_config_error"
                        }
                      },
                      {
                        "stop": "Saknar batterikapacitet."
                      }
                    ]
                  },
                  {
                    "conditions": [
                      {
                        "condition": "template",
                        "value_template": "{{ car_charger_kw | float(0) <= 0 }}"
                      }
                    ],
                    "sequence": [
                      {
                        "action": "logbook.log",
                        "data": {
                          "name": "{{ log_prefix }}",
                          "message": "Planeringen stoppad: s\u00e4tt ett v\u00e4rde p\u00e5 input_number.car_charger_capacity."
                        }
                      },
                      {
                        "action": "persistent_notification.create",
                        "data": {
                          "title": "Laddningsplan saknar laddareffekt",
                          "message": "Ange laddarens effekt i input_number.car_charger_capacity f\u00f6r att kunna planera laddningen.",
                          "notification_id": "granny_car_charge_plan_config_error"
                        }
                      },
                      {
                        "stop": "Saknar laddareffekt."
                      }
                    ]
                  }
                ]
              },
              {
                "action": "logbook.log",
                "data": {
                  "name": "{{ log_prefix }}",
                  "message": "Startar prisoptimerad planering av bilens laddning."
                }
              },
              {
                "variables": {
                  "planner_candidates": "{% set price_obj = price_payload | from_json %} {% set today_list = price_obj.get('today', []) if price_obj is mapping else [] %} {% set tomorrow_list = price_obj.get('tomorrow', []) if price_obj is mapping else [] %} {% set buckets = today_list + tomorrow_list %} {% set now_dt = as_datetime(now_iso) %} {% set slot_len = slot_minutes | int(15) %} {% set slot_secs = slot_len * 60 %} {% set start_ts = as_timestamp(now_dt) %} {% set remainder = start_ts % slot_secs %} {% if remainder == 0 %}\n  {% set window_start_dt = now_dt %}\n{% else %}\n  {% set window_start_dt = as_datetime(start_ts - remainder + slot_secs) %}\n{% endif %} {% set window_end_dt = as_datetime(deadline_iso) %} {% set total_slots = (((as_timestamp(window_end_dt) - as_timestamp(window_start_dt)) / 60) // slot_len) | int(0) + 2 %} {% set slots = namespace(items=[]) %} {% for idx in range(0, total_slots) %}\n  {% set slot_start_dt = window_start_dt + timedelta(minutes=slot_len * idx) %}\n  {% set slot_end_dt = slot_start_dt + timedelta(minutes=slot_len) %}\n  {% if slot_start_dt >= window_end_dt or slot_end_dt > window_end_dt %}\n    {% break %}\n  {% endif %}\n  {% set found = namespace(price=None, source='nordpool.unknown') %}\n  {% for bucket in buckets %}\n    {% set bucket_start = as_datetime(bucket.get('start')) %}\n    {% set bucket_end = as_datetime(bucket.get('end')) %}\n    {% if slot_start_dt >= bucket_start and slot_end_dt <= bucket_end %}\n      {% set found.price = bucket.get('value') | float(0) %}\n      {% set found.source = bucket.get('source', 'nordpool.today' if bucket in today_list else 'nordpool.tomorrow') %}\n      {% break %}\n    {% endif %}\n  {% endfor %}\n  {% if found.price is not none %}\n    {% set energy = slot_energy_kwh | float(0) %}\n    {% set slot_dict = {\n      'start': slot_start_dt.isoformat(),\n      'end': slot_end_dt.isoformat(),\n      'energy_kwh': energy,\n      'price_sek_kwh': found.price,\n      'cost_sek': (found.price | float(0)) * energy,\n      'source': found.source,\n      'currency': price_currency\n    } %}\n    {% set slots.items = slots.items + [slot_dict] %}\n  {% endif %}\n{% endfor %} {{ slots.items | tojson | from_json }}",
                  "planner_candidate_count": "{{ planner_candidates | length }}",
                  "planner_needed_slots": "{{ min_slots_required | int(0) }}",
                  "planner_selected_slots": "{% if energy_needed_kwh | float(0) <= 0 or planner_needed_slots | int(0) <= 0 %}\n  {{ [] }}\n{% else %}\n  {% set sorted = planner_candidates | sort(attribute='start') | sort(attribute='price_sek_kwh') %}\n  {% set picked = namespace(items=[]) %}\n  {% for slot in sorted %}\n    {% if picked.items | length < (planner_needed_slots | int(0)) %}\n      {% set picked.items = picked.items + [slot] %}\n    {% else %}\n      {% break %}\n    {% endif %}\n  {% endfor %}\n  {{ picked.items | sort(attribute='start') }}\n{% endif %}",
                  "planner_selected_count": "{{ planner_selected_slots | length }}",
                  "planner_deadline_ok": "{% if planner_selected_slots | length == 0 %}\n  true\n{% else %}\n  {% set last_end_dt = as_datetime(planner_selected_slots[-1].end) %}\n  {% set deadline_dt = as_datetime(deadline_iso) %}\n  {{ last_end_dt <= deadline_dt }}\n{% endif %}",
                  "planner_total_energy_kwh": "{% set total = namespace(value=0.0) %} {% for slot in planner_selected_slots %}\n  {% set total.value = total.value + (slot.energy_kwh | float(0)) %}\n{% endfor %} {{ total.value }}",
                  "planner_total_cost_sek": "{% set total = namespace(value=0.0) %} {% for slot in planner_selected_slots %}\n  {% set total.value = total.value + (slot.cost_sek | float(0)) %}\n{% endfor %} {{ total.value }}",
                  "plan_data": "{% set need = energy_needed_kwh | float(0) %} {% set slots = planner_selected_slots %} {% if need <= 0 %}\n  {% set status = 'klar' %}\n  {% set summary = 'Batteriet \u00e4r redan \u00f6ver m\u00e5let. Ingen laddning planeras.' %}\n{% elif slots | length == 0 %}\n  {% set status = 'saknar_slotar' %}\n  {% set summary = 'Inga slotar kunde tas fram \u2013 saknar prisdata i tidsf\u00f6nstret.' %}\n{% else %}\n  {% set status = 'planerad' %}\n  {% set summary = 'Planerade ' ~ (slots | length) ~ ' slotar med l\u00e4gsta timpriser i nuvarande f\u00f6nster.' %}\n{% endif %} {{ {\n  'status': status,\n  'summary': summary,\n  'notes': 'Automatisk prisplan framr\u00e4knad lokalt.',\n  'deadline_met': planner_deadline_ok,\n  'slots_planned': slots | length,\n  'currency': price_currency,\n  'schedule': slots,\n  'total_energy_kwh': planner_total_energy_kwh | float(0),\n  'total_cost_sek': planner_total_cost_sek | float(0)\n} | tojson | from_json }}",
                  "plan_schedule_raw": "{{ plan_data.get('schedule', []) }}",
                  "plan_currency": "{% if plan_data is mapping %}\n  {{ plan_data.get('currency', price_currency) | default(price_currency) }}\n{% else %}\n  {{ price_currency }}\n{% endif %}"
                }
              },
              {
                "action": "system_log.write",
                "data": {
                  "level": "info",
                  "logger": "granny_car_charge_plan",
                  "message": "Planner debug: price_currency={{ price_currency }}, attr={{ price_currency_attr }}, candidates={{ planner_candidate_count }}, needed={{ planner_needed_slots }}, selected={{ planner_selected_count }}, total_energy={{ planner_total_energy_kwh | float(0) }}, total_cost={{ planner_total_cost_sek | float(0) }}"
                }
              },
              {
                "action": "system_log.write",
                "data": {
                  "level": "info",
                  "logger": "granny_car_charge_plan",
                  "message": "Plan data (auto): {{ plan_data }}"
                }
              },
              {
                "action": "system_log.write",
                "data": {
                  "level": "info",
                  "logger": "granny_car_charge_plan",
                  "message": "Plan raw schedule (auto): {{ plan_schedule_raw }}"
                }
              },
              {
                "variables": {
                  "plan_schedule_initial": "{% set raw = plan_schedule_raw %} {% if raw is string %}\n  {% set raw = raw | from_json(default=[]) %}\n{% endif %} {% if raw is mapping %}\n  {% set raw = raw.get('time', raw.get('slots', raw.get('schedule', raw.get('planned_schedule', raw.get('chargeSessions', raw.get('sessions', raw.get('windows', []))))))) %}\n{% endif %} {% if raw is string %}\n  {% set raw = raw | from_json(default=[]) %}\n{% endif %} {% if raw is mapping %}\n  {% set raw = raw.get('time', raw.get('slots', raw.get('schedule', raw.get('planned_schedule', raw.get('chargeSessions', raw.get('sessions', raw.get('windows', []))))))) %}\n{% endif %} {% if raw is iterable %}\n  {% set raw_list = raw | list %}\n{% else %}\n  {% set raw_list = [] %}\n{% endif %} {% set normalized = namespace(items=[]) %} {% for slot in raw_list %}\n  {% set item = slot %}\n  {% if item is string %}\n    {% set item = item | from_json(default={}) %}\n  {% endif %}\n  {% if item is mapping %}\n    {% set interval = item.get('time_interval') %}\n    {% set start = item.get('start') %}\n    {% set end = item.get('end') %}\n    {% if interval %}\n      {% set start = start or interval.get('start') %}\n      {% set end = end or interval.get('end') %}\n    {% endif %}\n    {% set start = start or item.get('startTime') or item.get('start_time') or item.get('timeStart') or item.get('time_start') or item.get('slot_start_time') or item.get('slot_start') %}\n    {% set end = end or item.get('endTime') or item.get('end_time') or item.get('timeEnd') or item.get('time_end') or item.get('timeStop') or item.get('slot_end_time') or item.get('slot_end') %}\n    {% if start %}\n      {% if start | string | length == 15 and 'T' not in start %}\n        {% set start = start | replace(' ', 'T') %}\n      {% endif %}\n    {% endif %}\n    {% if end %}\n      {% if end | string | length == 15 and 'T' not in end %}\n        {% set end = end | replace(' ', 'T') %}\n      {% endif %}\n    {% endif %}\n    {% set energy = item.get('energy_kwh') %}\n    {% if energy is none %}\n      {% set energy = item.get('energy') %}\n    {% endif %}\n    {% if energy is none %}\n      {% set energy = item.get('kwh', item.get('kWh')) %}\n    {% endif %}\n    {% if energy is none %}\n      {% set energy = item.get('consumption_kwh', item.get('consumption_KWh', item.get('consumption'))) %}\n    {% endif %}\n    {% set price = item.get('price_sek_kwh') %}\n    {% for key in [\n      'price_SEK_per_kWh', 'price_SEK_per_kwh', 'price_sek_per_kwh', 'price_per_kwh', 'price_per_kWh',\n      'price_per_kw', 'price_perKWh', 'price_per_unit', 'price_per_unit_sek', 'price_per_kW',\n      'price_per', 'price', 'price_per_hour', 'price_kwh', 'price_SEK'\n    ] %}\n      {% if price is none and item.get(key) is not none %}\n        {% set price = item.get(key) %}\n      {% endif %}\n    {% endfor %}\n    {% set cost = item.get('cost_sek') %}\n    {% if cost is none %}\n      {% set cost = item.get('cost_SEK') %}\n    {% endif %}\n    {% if cost is none %}\n      {% set cost = item.get('cost') %}\n    {% endif %}\n    {% if cost is none %}\n      {% set cost = item.get('price_total', item.get('total_cost')) %}\n    {% endif %}\n    {% if cost is none and price is not none and energy is not none %}\n      {% set cost = (price | float(0)) * (energy | float(0)) %}\n    {% endif %}\n    {% set norm = {\n      \"start\": start,\n      \"end\": end,\n      \"energy_kwh\": energy,\n      \"price_sek_kwh\": price,\n      \"cost_sek\": cost,\n      \"source\": item.get('source'),\n      \"currency\": item.get('currency', plan_currency)\n    } %}\n    {% set normalized.items = normalized.items + [norm] %}\n  {% endif %}\n{% endfor %} {{ normalized.items | tojson | from_json }}",
                  "plan_schedule_initial_len": "{{ plan_schedule_initial | length }}",
                  "plan_schedule": "{{ plan_schedule_initial | selectattr(\"start\", \"defined\") | list }}",
                  "plan_status": "{% if plan_data is mapping %}\n  {{ plan_data.get('status', '') }}\n{% else %}\n  ''\n{% endif %}",
                  "plan_summary": "{% if plan_data is mapping %}\n  {{ plan_data.get('summary', '') }}\n{% else %}\n  ''\n{% endif %}",
                  "plan_notes": "{% if plan_data is mapping %}\n  {{ plan_data.get('notes', plan_data.get('summary', '')) }}\n{% else %}\n  ''\n{% endif %}",
                  "plan_summary_clean": "{{ plan_summary | replace(\"\u20ac\", plan_currency) | replace(\"EUR\", plan_currency) }}",
                  "plan_notes_clean": "{{ plan_notes | replace(\"\u20ac\", plan_currency) | replace(\"EUR\", plan_currency) }}",
                  "plan_deadline_met": "{% if plan_data is mapping %}\n  {% set raw = plan_data.get('deadline_met', plan_data.get('deadline_ok', None)) %}\n{% else %}\n  {% set raw = None %}\n{% endif %} {{ raw in [True, 'True', 'true', 1, '1'] }}",
                  "plan_slots_planned": "{% if plan_data is mapping %}\n  {% set raw = plan_data.get('slots_planned') %}\n{% else %}\n  {% set raw = None %}\n{% endif %} {% if raw is number %}\n  {{ raw | int }}\n{% elif raw in [None, ''] %}\n  {{ plan_schedule_initial_len }}\n{% else %}\n  {{ (raw | int(0)) if raw is not none else plan_schedule_initial_len }}\n{% endif %}",
                  "plan_schedule_filtered_json": "{% set window_start_dt = as_datetime(now_iso) %} {% set window_end_dt = as_datetime(deadline_iso) %} {% set window_start_ts = as_timestamp(window_start_dt) %} {% set window_end_ts = as_timestamp(window_end_dt) %} {% set kept = namespace(items=[]) %} {% for slot in plan_schedule %}\n  {% set start_val = slot.get('start') %}\n  {% set end_val = slot.get('end') %}\n  {% set start_dt = as_datetime(start_val) if start_val else None %}\n  {% set end_dt = as_datetime(end_val) if end_val else None %}\n  {% set start_ts = as_timestamp(start_dt) if start_dt else None %}\n  {% set end_ts = as_timestamp(end_dt) if end_dt else None %}\n  {% if start_ts is not none and end_ts is not none and start_ts >= window_start_ts and end_ts <= window_end_ts %}\n    {% set kept.items = kept.items + [slot] %}\n  {% endif %}\n{% endfor %} {{ kept.items | tojson }}",
                  "plan_schedule_filter_debug": "{% set window_start_dt = as_datetime(now_iso) %} {% set window_end_dt = as_datetime(deadline_iso) %} {% set window_start_ts = as_timestamp(window_start_dt) %} {% set window_end_ts = as_timestamp(window_end_dt) %} {% set ns = namespace(lines=[]) %} {% for slot in plan_schedule %}\n  {% set start_val = slot.get('start') %}\n  {% set end_val = slot.get('end') %}\n  {% set start_dt = as_datetime(start_val) if start_val else None %}\n  {% set end_dt = as_datetime(end_val) if end_val else None %}\n  {% set start_ts = as_timestamp(start_dt) if start_dt else None %}\n  {% set end_ts = as_timestamp(end_dt) if end_dt else None %}\n  {% set keep = (start_ts is not none and end_ts is not none and start_ts >= window_start_ts and end_ts <= window_end_ts) %}\n  {% set ns.lines = ns.lines + ['slot=' ~ (slot | tojson) ~ ', start_ts=' ~ (start_ts|string if start_ts is not none else 'none') ~ ', end_ts=' ~ (end_ts|string if end_ts is not none else 'none') ~ ', keep=' ~ keep|string] %}\n{% endfor %} {{ ns.lines | join(' | ') }}",
                  "plan_schedule_candidate_valid": "{% set window_start_dt = as_datetime(now_iso) %} {% set window_end_dt = as_datetime(deadline_iso) %} {% set window_start_ts = as_timestamp(window_start_dt) %} {% set window_end_ts = as_timestamp(window_end_dt) %} {% set ns = namespace(valid=true) %} {% for slot in plan_schedule %}\n  {% set start_val = slot.get('start') %}\n  {% set end_val = slot.get('end') %}\n  {% set start_dt = as_datetime(start_val) if start_val else None %}\n  {% set end_dt = as_datetime(end_val) if end_val else None %}\n  {% set start_ts = as_timestamp(start_dt) if start_dt else None %}\n  {% set end_ts = as_timestamp(end_dt) if end_dt else None %}\n  {% if start_ts is none or end_ts is none or start_ts < window_start_ts or end_ts > window_end_ts %}\n    {% set ns.valid = false %}\n  {% endif %}\n{% endfor %} {{ ns.valid }}"
                }
              },
              {
                "variables": {
                  "plan_schedule_effective_raw": "{{ plan_schedule_filtered_json | from_json(default=[]) }}",
                  "plan_schedule_effective": "{% set filtered = plan_schedule_filtered_json | from_json(default=[]) %} {% set fallback_ok = (plan_schedule_initial_len > 0) and (filtered | length == 0) and (plan_schedule_candidate_valid in [True, 'True', 'true', 1, '1']) %} {% set chosen = plan_schedule if fallback_ok else filtered %} {{ chosen | tojson | from_json }}",
                  "schedule_removed_count": "{{ plan_schedule_initial_len - (plan_schedule_effective | length) }}",
                  "schedule_fallback_used": "{{ (plan_schedule_effective_raw | length == 0) and (plan_schedule_effective | length > 0) }}",
                  "schedule_start_failed": "{{ (plan_schedule_initial_len > 0) and (plan_schedule_effective | length == 0) }}",
                  "plan_energy_total": "{% set total = namespace(value=0.0) %} {% for slot in plan_schedule_effective %}\n  {% set slot_obj = slot %}\n  {% if slot_obj is string %}\n    {% set slot_obj = slot_obj | from_json(default={}) %}\n  {% endif %}\n  {% if slot_obj is mapping %}\n    {% if 'energy_kwh' in slot_obj %}\n      {% set energy = slot_obj['energy_kwh'] %}\n    {% elif 'energy' in slot_obj %}\n      {% set energy = slot_obj['energy'] %}\n    {% else %}\n      {% set energy = None %}\n    {% endif %}\n    {% if energy is not none %}\n      {% set total.value = total.value + (energy | float(0)) %}\n    {% endif %}\n  {% endif %}\n{% endfor %} {{ total.value }}",
                  "energy_goal_met": "{% set needed = energy_needed_kwh | float(0) %} {% set total = plan_energy_total | float(0) %} {% if needed <= 0 %}\n  true\n{% else %}\n  {{ (total + 0.001) >= needed }}\n{% endif %}",
