                  "total_cost_value": "{% set total = namespace(value=0.0) %} {% for slot in plan_schedule_effective %}\n  {% set slot_obj = slot %}\n  {% if slot_obj is string %}\n    {% set slot_obj = slot_obj | from_json(default={}) %}\n  {% endif %}\n  {% if slot_obj is mapping %}\n    {% if 'cost_sek' in slot_obj %}\n      {% set cost = slot_obj['cost_sek'] %}\n    {% elif 'cost' in slot_obj %}\n      {% set cost = slot_obj['cost'] %}\n    {% else %}\n      {% set cost = None %}\n    {% endif %}\n    {% if 'price_sek_kwh' in slot_obj %}\n      {% set price = slot_obj['price_sek_kwh'] %}\n    {% elif 'price' in slot_obj %}\n      {% set price = slot_obj['price'] %}\n    {% else %}\n      {% set price = None %}\n    {% endif %}\n    {% if 'energy_kwh' in slot_obj %}\n      {% set energy = slot_obj['energy_kwh'] %}\n    {% elif 'energy' in slot_obj %}\n      {% set energy = slot_obj['energy'] %}\n    {% else %}\n      {% set energy = None %}\n    {% endif %}\n    {% if cost is not none %}\n      {% set total.value = total.value + (cost | float(0)) %}\n    {% elif price is not none and energy is not none %}\n      {% set total.value = total.value + ((price | float(0)) * (energy | float(0))) %}\n    {% endif %}\n  {% endif %}\n{% endfor %} {% set summed = total.value %} {% if (summed | float(0)) <= 0 and plan_data is mapping %}\n  {% if plan_data.get('total_cost_sek') is not none %}\n    {{ plan_data.get('total_cost_sek') | float(0) }}\n  {% elif plan_data.get('total_cost') is not none %}\n    {{ plan_data.get('total_cost') | float(0) }}\n  {% elif plan_data.get('total_cost_eur') is not none %}\n    {{ plan_data.get('total_cost_eur') | float(0) }}\n  {% else %}\n    {{ summed }}\n  {% endif %}\n{% else %}\n  {{ summed }}\n{% endif %}"
