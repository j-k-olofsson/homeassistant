      {"created_at":"1970-01-01T00:00:00+00:00","data":{},"disabled_by":null,"discovery_keys":{},"domain":"sql","entry_id":"b1c9561264233cce319c21ed66a816f6","minor_version":1,"modified_at":"2024-08-11T17:48:19.646469+00:00","options":{"column":"Förbrukat","name":"Select SQL Query","query":"SELECT (ROUND(SUM(a.state * b.mean),0) + 954) as 'Förbrukat'\nfrom homeassistant.statistics a\njoin homeassistant.statistics b\non a.start_ts = b.start_ts\nwhere a.metadata_id = 320\nand b.metadata_id = 223\nand FROM_UNIXTIME(a.start_ts,\"%Y %M\") = FROM_UNIXTIME(UNIX_TIMESTAMP(),\"%Y %M\")\ngroup by FROM_UNIXTIME(a.start_ts,\"%Y %M\")\norder by a.start_ts;","unit_of_measurement":":-"},"pref_disable_new_entities":false,"pref_disable_polling":false,"source":"user","title":"Elkostnad (just nu)","unique_id":null,"version":1},
      {"created_at":"1970-01-01T00:00:00+00:00","data":{},"disabled_by":null,"discovery_keys":{},"domain":"sql","entry_id":"82eb7c6d68f250ab2de9349736e67edb","minor_version":1,"modified_at":"2024-08-11T17:48:41.393079+00:00","options":{"column":"Prognos","name":"Select SQL Query","query":"SELECT ROUND(((ROUND(SUM(a.state * b.mean),0)) / TIMESTAMPDIFF(HOUR, CONCAT(YEAR(NOW()), '-', MONTH(now()), '-1'), NOW()) ) * (DAYOFMONTH(LAST_DAY(NOW())) * 24) + 954, 0) as 'Prognos'\nfrom homeassistant.statistics a\njoin homeassistant.statistics b\non a.start_ts = b.start_ts\nwhere a.metadata_id = 320\nand b.metadata_id = 223\nand FROM_UNIXTIME(a.start_ts,\"%Y %M\") = FROM_UNIXTIME(UNIX_TIMESTAMP(),\"%Y %M\")\ngroup by FROM_UNIXTIME(a.start_ts,\"%Y %M\")\norder by a.start_ts;","unit_of_measurement":":-"},"pref_disable_new_entities":false,"pref_disable_polling":false,"source":"user","title":"Elprognos","unique_id":null,"version":1},
