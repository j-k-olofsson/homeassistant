                "condition": "template",
                "value_template": "{% set sd = trigger.event.data.service_data if trigger.event and trigger.event.data else {} %} {% set eid = sd.entity_id if sd is mapping and 'entity_id' in sd else none %} {% if eid is string %}\n  {{ eid in ['light.taklampor_kokson', 'light.grupp_taklampor_kok'] }}\n{% elif eid is iterable and eid is not string %}\n  {{ 'light.taklampor_kokson' in eid or 'light.grupp_taklampor_kok' in eid }}\n{% else %}\n  false\n{% endif %}"
