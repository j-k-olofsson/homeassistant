    "9842167e-772a-ad9d-6664-74077d0f77e6||protocol||flow_mode_sample_rate": {
      "key": "9842167e-772a-ad9d-6664-74077d0f77e6||protocol||flow_mode_sample_rate",
      "type": "string",
      "default_value": "smart",
      "required": true,
      "options": [
        {
          "value": "smart",
          "title": "Smart",
          "disabled": false,
          "disabled_reason": null,
          "description": "Starts at the first track's rate; upsamples lower-rate tracks to match, and restarts the stream only when a track has a higher rate. Best balance of quality and seamless playback."
        },
        {
          "value": "bit_perfect",
          "title": "Bit-perfect",
          "disabled": false,
          "disabled_reason": null,
          "description": "Never resamples. Playback restarts between tracks of differing sample rates, which disables gapless and crossfade across those transitions."
        },
        {
          "value": "48000",
          "title": "48 kHz",
          "disabled": false,
          "disabled_reason": null,
          "description": "Resamples everything to a fixed 48 kHz (or the closest rate the player supports). A good compromise of quality and bandwidth."
        },
        {
          "value": "96000",
          "title": "96 kHz",
          "disabled": false,
          "disabled_reason": null,
          "description": "Resamples everything to a fixed 96 kHz (or the closest rate the player supports)."
        },
        {
          "value": "highest",
          "title": "Highest supported by player",
          "disabled": false,
          "disabled_reason": null,
          "description": "Resamples everything to the highest rate the player supports. Best quality, but can waste a lot of bandwidth."
        }
      ],
      "range": null,
      "format": null,
      "description": "When streaming in Flow Mode, the entire queue is sent as one gapless stream and must use a single sample rate for the whole stream.",
