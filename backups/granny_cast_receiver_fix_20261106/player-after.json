    "http_profile": {
      "key": "http_profile",
      "type": "string",
      "default_value": "no_content_length",
      "required": true,
      "options": [
        {
          "value": "chunked",
          "title": "Profile 1 - chunked",
          "disabled": false,
          "disabled_reason": null,
          "description": "Send audio using chunked transfer encoding, without a fixed length up front."
        },
        {
          "value": "no_content_length",
          "title": "Profile 2 - no content length",
          "disabled": false,
          "disabled_reason": null,
          "description": "Stream without a Content-Length header. Works for most players (the default)."
        },
        {
          "value": "forced_content_length",
          "title": "Profile 3 - forced content length",
          "disabled": false,
          "disabled_reason": null,
          "description": "Send an estimated Content-Length header. Some players need this to start playback or to seek."
        }
      ],
      "range": null,
      "format": null,
      "description": "This is considered to be a very advanced setting, only adjust this if needed, for example if your player stops playing halfway streams or if you experience other playback related issues. In most cases the default setting is fine.",
