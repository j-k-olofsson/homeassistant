    "output_codec": {
      "key": "output_codec",
      "type": "string",
      "default_value": "flac",
      "required": true,
      "options": [
        {
          "value": "flac",
          "title": "FLAC (lossless, compressed)",
          "disabled": false,
          "disabled_reason": null,
          "description": "Lossless and compressed \u2014 full quality at a moderate bitrate. The default and best choice for most players."
        },
        {
          "value": "mp3",
          "title": "MP3 (lossy)",
          "disabled": false,
          "disabled_reason": null,
          "description": "Lossy \u2014 smaller bitrate at some quality cost. Use for players that can't play FLAC, or to save bandwidth."
        },
        {
          "value": "aac",
          "title": "AAC (lossy)",
          "disabled": false,
          "disabled_reason": null,
          "description": "Lossy \u2014 comparable to MP3; pick it for players that prefer AAC."
        },
        {
          "value": "wav",
          "title": "WAV (uncompressed PCM)",
          "disabled": false,
          "disabled_reason": null,
          "description": "Uncompressed PCM audio in a WAV container \u2014 highest bandwidth. Only needed for players that can't handle FLAC."
        }
      ],
      "range": null,
      "format": null,
      "description": "Select the codec to use for streaming audio to this player. \nBy default, Music Assistant sends lossless, high quality audio to all players and prefers the FLAC codec because it offers some compression while still remaining lossless \n\nSome players however do not support FLAC and require the stream to be packed into e.g. a lossy mp3 codec or you like to save some network bandwidth. \n\n Choosing a lossy codec saves some bandwidth at the cost of audio quality.",
      "help_link": null,
      "multi_value": false,
      "expanded_options": false,
      "depends_on": null,
      "depends_on_value": null,
      "depends_on_value_not": null,
      "hidden": false,
      "read_only": false,
      "category": "protocol_chromecast",
      "action": null,
      "action_label": null,
      "immediate_apply": false,
      "requires_reload": true,
      "advanced": true,
      "label": "Output codec to use for streaming audio to the player",
      "category_label": "Enable Chromecast support",
      "value": "flac"
    },
