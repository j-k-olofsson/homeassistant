            "unit_before_value": true,
            "font_size_reduction": 5,
            "color": "#ffffff"
          },
          "secondary": {
            "unit_of_measurement": "Moln",
            "color": "#64b5c6",
            "value": "{{ ('%.1f' | format(states('sensor.openuv_aktuellt_uv_index') | float)) | replace('.', ',') if is_number(states('sensor.openuv_aktuellt_uv_index')) else '—' }}",
