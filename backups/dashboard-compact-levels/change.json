          "gradient_resolution": "auto",
          "round": "full"
        },
        "titles": {
          "primary": {
            "value": "UV",
            "font_size": "12px"
          },
          "secondary": {
            "value": "Max {{ ('%.1f' | format(states('sensor.openuv_max_uv_index') | float)) | replace('.', ',') if is_number(states('sensor.openuv_max_uv_index')) else '—' }}",
            "font_size": "10px",
            "color": "#64b5c6"
          }
        },
        "value_texts": {
          "primary": {
            "unit_of_measurement": "Egen",
