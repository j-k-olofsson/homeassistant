          "style": "ha-state-icon {\n  animation: {{ 'vehicle-soft-pulse 4s ease-in-out infinite' if is_state('switch.billaddare', 'on') and is_state('sensor.sef_42h_charging_status', 'charging') else 'none' }};\n}\n@keyframes vehicle-soft-pulse {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.65; }\n}\n@media (prefers-reduced-motion: reduce) {\n  ha-state-icon { animation: none; }\n}\n"
        }
      },
